#include <iostream>

using namespace std;

int main(){
    int n, a;
    cin >> n;
    int masiv[n];
    int* ptr = masiv;
    for (int i = 0; i < n; i++){
        cin >> *(ptr + i);
    }
    for (int j = 0; j < n; j++){
        if (*(ptr + j) % 2 == 0){
            a += *(ptr + j);
            cout << a << endl;
        
        }
    }
}
